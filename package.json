{
    "name": "init-gcz",
    "version": "0.0.1",
    "description": "init git commitlint env based on Conventional Commits specification.",
    "main": "package.json",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "prepare": "husky",
        "commit": "cz",
        "release": "commit-and-tag-version"
